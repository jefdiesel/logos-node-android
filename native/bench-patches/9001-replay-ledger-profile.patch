-use std::hash::Hash;
+use std::{hash::Hash, time::Instant};
 
+/// Bench-only timing counters (logos-node-android bench patch 9001, never shipped).
+pub mod bench_timing {
+    use std::{
+        sync::atomic::{AtomicU64, Ordering},
+        time::Duration,
+    };
+
+    pub static CRYPTARCHIA_HEADER: AtomicU64 = AtomicU64::new(0);
+    pub static MANTLE_HEADER: AtomicU64 = AtomicU64::new(0);
+    pub static SEEN_BLOCK: AtomicU64 = AtomicU64::new(0);
+    pub static TXS: AtomicU64 = AtomicU64::new(0);
+    pub static BLOCK_ACCOUNTING: AtomicU64 = AtomicU64::new(0);
+    pub static POW_DIFFICULTY: AtomicU64 = AtomicU64::new(0);
+    pub static STATE_CLONE: AtomicU64 = AtomicU64::new(0);
+    pub static TX_COUNT: AtomicU64 = AtomicU64::new(0);
+
+    pub fn reset() {
+        for c in [
+            &CRYPTARCHIA_HEADER, &MANTLE_HEADER, &SEEN_BLOCK, &TXS, &BLOCK_ACCOUNTING,
+            &POW_DIFFICULTY, &STATE_CLONE, &TX_COUNT,
+        ] {
+            c.store(0, Ordering::Relaxed);
+        }
+    }
+
+    pub fn add(c: &AtomicU64, d: Duration) {
+        c.fetch_add(u64::try_from(d.as_nanos()).unwrap_or(u64::MAX), Ordering::Relaxed);
+    }
+
+    pub fn secs(c: &AtomicU64) -> f64 {
+        Duration::from_nanos(c.load(Ordering::Relaxed)).as_secs_f64()
+    }
+
+    pub fn count(c: &AtomicU64) -> u64 {
+        c.load(Ordering::Relaxed)
+    }
+}
