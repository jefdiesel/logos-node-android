+/// Patch 0001: replaying the same stored chain with fast and with full
+/// verification must rebuild exactly the same chain and the same ledger
+/// states, which must also equal the states built when the blocks first came
+/// from the network.
+///
+/// Build `G -- B1 -- ... -- B5` (B2 and B4 carry a transaction with a
+/// deferred proof), store it through `process_block`, then recover it twice
+/// from `LIB = B1`, once per mode.
+#[tokio::test(flavor = "multi_thread")]
+async fn fast_and_full_replay_rebuild_the_same_state() {
+    type Tx = SignedOps<Preverified, StandardMode>;
+
+    let (broadcast_tx, _broadcast_rx) = mpsc::channel(10);
+    let (storage_tx, storage_rx) = mpsc::channel(10);
+    let _storage_svc = spawn_storage_service(storage_rx);
+    let (time_tx, _time_rx) = mpsc::channel(10);
+    let relays = CryptarchiaConsensusRelays::<Tx>::new(
+        OutboundRelay::new(broadcast_tx),
+        StorageApi::new(OutboundRelay::new(storage_tx)),
+        OutboundRelay::new(time_tx),
+    );
+    let (new_block_tx, _new_block_rx) = broadcast::channel(100);
+    let (lib_tx, _lib_rx) = broadcast::channel(100);
+
+    let config = ledger_config(3.try_into().unwrap());
+    let genesis_id: HeaderId = GENESIS_ID.into();
+    let (zk_key, leader_utxo) = utxo();
+    let (_, funding_a) = utxo();
+    let (_, funding_b) = utxo();
+    let mut stored = Cryptarchia::from_genesis(
+        genesis_id,
+        LedgerState::from_utxos([leader_utxo, funding_a, funding_b], &config),
+        config,
+        lb_cryptarchia_engine::State::Bootstrapping,
+    );
+
+    // Before the restart: the blocks are verified and stored.
+    let block_txs = [
+        None,
+        Some(burn_tx(funding_a, &zk_key)),
+        None,
+        Some(burn_tx(funding_b, &zk_key)),
+        None,
+    ];
+    let mut blocks = Vec::new();
+    let mut slot = Slot::genesis().strict_add(1.into());
+    for tx in block_txs {
+        let transactions = tx.map_or_else(BlockTransactions::empty, |tx| {
+            BlockTransactions::from([tx])
+        });
+        let (block, _) = try_build_block_with_transactions(
+            &stored,
+            stored.tip(),
+            leader_utxo,
+            &zk_key,
+            slot,
+            UncleHeaders::empty(),
+            transactions,
+        )
+        .expect("should find a winning slot");
+        slot = block.header().slot().strict_add(1.into());
+        process_block(
+            &mut stored,
+            block.clone(),
+            block.header().slot(),
+            BlockOrigin::Network,
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+        )
+        .await
+        .expect("the block should be valid before the restart");
+        blocks.push(block);
+    }
+    let b1 = &blocks[0];
+    let tip = blocks.last().unwrap();
+    let (b1_id, tip_id) = (b1.header().id(), tip.header().id());
+    assert_eq!(stored.tip(), tip_id);
+
+    let recovery_state = CryptarchiaConsensusState {
+        tip: tip_id,
+        lib: b1_id,
+        lib_ledger_state: stored.ledger.state(&b1_id).unwrap().clone(),
+        lib_block_length: 1,
+        lib_block_slot: b1.header().slot(),
+        lib_block_uncle_slots: UncleSlots::default(),
+        genesis_id,
+        storage_blocks_to_remove: HashSet::new(),
+        last_engine_state: None,
+    };
+    let bootstrap_config = BootstrapConfig {
+        prolonged_bootstrap_period: std::time::Duration::ZERO,
+        force_bootstrap: true,
+        offline_grace_period: OfflineGracePeriodConfig::default(),
+    };
+
+    let mut recovered = Vec::new();
+    for mode in [ReplayVerification::Full, ReplayVerification::Fast] {
+        let initialized = CryptarchiaConsensus::<
+            Tx,
+            SystemTimeBackend,
+            TestRuntimeServiceId,
+        >::initialize_cryptarchia_with(
+            &recovery_state,
+            &bootstrap_config,
+            stored.ledger.config().clone(),
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+            tip.header().slot(),
+            mode,
+        )
+        .await
+        .unwrap_or_else(|e| panic!("the chain should be recovered with {mode:?} replay: {e}"));
+        assert!(!initialized.fell_back_to_lib);
+        recovered.push(initialized.cryptarchia);
+    }
+    let (full, fast) = (&recovered[0], &recovered[1]);
+
+    assert_eq!(full.tip(), tip_id);
+    assert_eq!(full.lib(), b1_id);
+    assert_eq!(fast.info(), full.info());
+    assert_eq!(fast.consensus, full.consensus);
+    assert_eq!(fast.ledger, full.ledger);
+    for block in &blocks {
+        let id = block.header().id();
+        let state = fast.ledger.state(&id).expect("every replayed block has a state");
+        assert_eq!(
+            Some(state),
+            stored.ledger.state(&id),
+            "replayed ledger state differs from the original for {id}"
+        );
+    }
+}
