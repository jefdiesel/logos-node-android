+//! Fast replay of the node's own stored blocks at startup.
+//!
+//! Added by the logos-node-android patch `0001-fast-replay-from-own-storage`.
+//!
+//! At startup the chain is rebuilt from the last immutable block (LIB) by
+//! replaying every stored block after it. A fast replay skips the two
+//! expensive cryptographic re-checks for blocks this same build already
+//! verified: the leader proof (`PoL` Groth16) and the batch of deferred
+//! transaction proofs. Everything else runs for every block: decoding (header
+//! signature, body root, transaction pre-checks), the check that the block is
+//! the one it is stored under, the parent links, the full ledger transition
+//! and the consensus engine.
+//!
+//! Which blocks count as already verified is decided by the replay marker, a
+//! small file next to the database (see [`ReplayMarkerPaths`]). It names the
+//! build and a chain, `(tip, lib)`, that this build holds in memory and has
+//! verified: every block after `lib` up to `tip` was either verified on arrival
+//! from the network or replayed at startup under the same rules. The node
+//! rewrites it when it records its recovery state, at most every
+//! [`MARKER_MIN_INTERVAL`]. A header id is a hash of the header, which commits
+//! to the parent id and to the block body, so the vouched tip id pins the exact
+//! content of every vouched block.
+//!
+//! At the next start, a block is replayed fast only if the marker is from this
+//! build, the stored LIB is the marker's LIB, and the block is the marker's tip
+//! or one of its ancestors, followed through the parents named in the blocks'
+//! own headers (not the separate stored parent index). Every other block (all
+//! of them, if anything does not match) is replayed with full verification.
+//!
+//! Set `LOGOS_REPLAY_VERIFY=full` to re-verify everything on a start anyway.
+
+use std::{
+    cell::Cell,
+    ffi::OsString,
+    fmt::Write as _,
+    fs, io,
+    path::{Path, PathBuf},
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use lb_core::{
+    header::HeaderId,
+    mantle::ops::leader_claim::VoucherCm,
+    proofs::leader_proof::{LeaderProof, LeaderPublic},
+};
+use lb_groth16::Fr;
+use lb_key_management_system_keys::keys::UnverifiedEd25519PublicKey;
+use tracing::warn;
+
+use crate::{Cryptarchia, LOG_TARGET};
+
+/// The patches compiled into this node, for the startup log line.
+pub const NODE_PATCHES: &str = "0001-fast-replay-from-own-storage";
+
+/// Environment variable that forces a full replay.
+pub const REPLAY_VERIFY_ENV: &str = "LOGOS_REPLAY_VERIFY";
+
+/// First line of the marker file; a marker in any other format is ignored.
+const MARKER_FORMAT: &str = "logos-node-android replay marker v2";
+
+/// Whether [`REPLAY_VERIFY_ENV`] forces a full replay. Unset, empty or `fast`
+/// do not; `full` and any other value do, so a typo never turns verification
+/// off. Nothing can force a fast replay.
+#[must_use]
+pub fn forced_full(value: Option<&str>) -> bool {
+    match value.map(str::trim) {
+        None | Some("") => false,
+        Some(v) => !v.eq_ignore_ascii_case("fast"),
+    }
+}
+
+/// Identifies the code of this build: the upstream version, the patches, and
+/// the digest of every patch file applied to the source (set by the build as
+/// `LOGOS_NODE_PATCHES_ID`). `None` when the build did not set the digest; such
+/// a build never replays fast.
+#[must_use]
+pub fn build_id() -> Option<String> {
+    build_id_from(option_env!("LOGOS_NODE_PATCHES_ID"))
+}
+
+fn build_id_from(patches_id: Option<&str>) -> Option<String> {
+    let id = patches_id.map(str::trim).filter(|id| !id.is_empty() && *id != "-")?;
+    Some(format!(
+        "{} {} {}",
+        env!("CARGO_PKG_VERSION"),
+        NODE_PATCHES,
+        id
+    ))
+}
+
+/// A chain this build verified: every block after `lib` up to `tip`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct VouchedChain {
+    pub tip: HeaderId,
+    pub lib: HeaderId,
+}
+
+fn hex(id: HeaderId) -> String {
+    <[u8; 32]>::from(id)
+        .iter()
+        .fold(String::with_capacity(64), |mut s, b| {
+            let _ = write!(s, "{b:02x}");
+            s
+        })
+}
+
+fn parse_hex(s: &str) -> Option<HeaderId> {
+    if s.len() != 64 || !s.is_ascii() {
+        return None;
+    }
+    let mut bytes = [0u8; 32];
+    for (i, byte) in bytes.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(s.get(2 * i..2 * i + 2)?, 16).ok()?;
+    }
+    Some(HeaderId::from(bytes))
+}
+
+#[must_use]
+pub fn marker_contents(build: &str, vouched: VouchedChain) -> String {
+    format!(
+        "{MARKER_FORMAT}\nbuild {build}\ntip {}\nlib {}\n",
+        hex(vouched.tip),
+        hex(vouched.lib)
+    )
+}
+
+/// The chain a marker vouches for, if the marker is well formed and was
+/// written by `build`.
+#[must_use]
+pub fn parse_marker(contents: &str, build: &str) -> Option<VouchedChain> {
+    let mut lines = contents.lines();
+    if lines.next()? != MARKER_FORMAT || lines.next()?.strip_prefix("build ")? != build {
+        return None;
+    }
+    let tip = parse_hex(lines.next()?.strip_prefix("tip ")?)?;
+    let lib = parse_hex(lines.next()?.strip_prefix("lib ")?)?;
+    if lines.next().is_some() {
+        return None;
+    }
+    Some(VouchedChain { tip, lib })
+}
+
+/// Chooses what this start may replay fast.
+///
+/// `env` is the value of [`REPLAY_VERIFY_ENV`], `build` this build's id,
+/// `marker` the marker file's contents and `stored_lib` the LIB of the stored
+/// recovery state. Returns the vouched chain (blocks up to its tip replay
+/// fast) or `None` (everything replays in full), with the reason.
+#[must_use]
+pub fn choose_replay(
+    env: Option<&str>,
+    build: Option<&str>,
+    marker: Option<&str>,
+    stored_lib: HeaderId,
+) -> (Option<VouchedChain>, &'static str) {
+    if forced_full(env) {
+        return (None, "full replay forced by LOGOS_REPLAY_VERIFY");
+    }
+    let Some(build) = build else {
+        return (None, "full replay: this build has no patch-set id");
+    };
+    let Some(marker) = marker else {
+        return (None, "full replay: no replay marker");
+    };
+    let Some(vouched) = parse_marker(marker, build) else {
+        return (
+            None,
+            "full replay: the replay marker is from another build or unreadable",
+        );
+    };
+    if vouched.lib != stored_lib {
+        return (
+            None,
+            "full replay: the stored LIB is not the LIB the replay marker vouches for",
+        );
+    }
+    (
+        Some(vouched),
+        "blocks up to the replay marker's tip replay fast, any later blocks in full",
+    )
+}
+
+/// How many header-parent steps the walk from the vouched tip to the replay
+/// path may take before giving up (nothing is then replayed fast).
+pub const MAX_VOUCHED_WALK: usize = 10_000;
+
+/// For each block to replay, whether it may be replayed fast.
+///
+/// `ids` are the blocks in LIB->tip order (LIB excluded), as found through the
+/// stored parent index, and `header_parents` the parent each block's own
+/// header names. `anchor` is the index of the newest block on this path that
+/// the vouched tip is, or descends from, found by walking header parents from
+/// the vouched tip; `None` if the walk reached the LIB or failed.
+///
+/// Blocks up to the anchor are fast only while each block's header names the
+/// previous block on the path as its parent (the LIB for the first one), so
+/// the stored parent index cannot make a block fast that the vouched tip's
+/// headers do not lead to.
+#[must_use]
+pub fn fast_prefix(
+    ids: &[HeaderId],
+    header_parents: &[HeaderId],
+    lib: HeaderId,
+    anchor: Option<usize>,
+) -> Vec<bool> {
+    let mut fast = vec![false; ids.len()];
+    let Some(anchor) = anchor else {
+        return fast;
+    };
+    for i in 0..ids.len().min(anchor.saturating_add(1)) {
+        let expected_parent = if i == 0 { lib } else { ids[i - 1] };
+        if header_parents.get(i) != Some(&expected_parent) {
+            break;
+        }
+        fast[i] = true;
+    }
+    fast
+}
+
+/// Reads the marker (if the node has a marker location) and chooses what this
+/// start may replay fast; see [`choose_replay`].
+#[must_use]
+pub fn plan_replay(
+    paths: Option<&ReplayMarkerPaths>,
+    env: Option<&str>,
+    build: Option<&str>,
+    stored_lib: HeaderId,
+) -> (Option<VouchedChain>, &'static str) {
+    let marker = paths.and_then(ReplayMarkerPaths::read);
+    choose_replay(env, build, marker.as_deref(), stored_lib)
+}
+
+/// Where the replay marker lives: `<db>.replay-verified`, next to the
+/// database folder (never inside it, so a copy of the database folder does
+/// not carry it).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ReplayMarkerPaths {
+    pub marker: PathBuf,
+}
+
+impl ReplayMarkerPaths {
+    #[must_use]
+    pub fn next_to_db(db: &Path) -> Self {
+        let mut name = db
+            .file_name()
+            .map_or_else(|| OsString::from("db"), OsString::from);
+        name.push(".replay-verified");
+        Self {
+            marker: db.with_file_name(name),
+        }
+    }
+
+    /// The marker as it is on disk, if there is one.
+    #[must_use]
+    pub fn read(&self) -> Option<String> {
+        fs::read_to_string(&self.marker).ok()
+    }
+
+    /// Writes the marker (to a temporary file first, then renamed).
+    pub fn write(&self, contents: &str) -> io::Result<()> {
+        let mut tmp = self.marker.clone().into_os_string();
+        tmp.push(".tmp");
+        fs::write(&tmp, contents)?;
+        fs::rename(&tmp, &self.marker)
+    }
+}
+
+/// The marker is rewritten at most this often; the once-a-minute recovery
+/// state recording catches up with any change skipped in between.
+pub const MARKER_MIN_INTERVAL: Duration = Duration::from_secs(5);
+
+#[derive(Default)]
+struct WriterState {
+    written: Option<VouchedChain>,
+    attempted_at: Option<Instant>,
+    warned: bool,
+}
+
+/// Keeps the marker in step with the chain this process holds and verified.
+pub struct MarkerWriter {
+    paths: ReplayMarkerPaths,
+    build: String,
+    state: Mutex<WriterState>,
+}
+
+impl MarkerWriter {
+    #[must_use]
+    pub fn new(paths: ReplayMarkerPaths, build: String) -> Self {
+        Self {
+            paths,
+            build,
+            state: Mutex::new(WriterState::default()),
+        }
+    }
+
+    /// Records that this process holds and verified `vouched`. Only call it
+    /// with the tip and LIB of the in-memory chain (see [`note_chain`]).
+    pub fn note(&self, vouched: VouchedChain) {
+        self.note_at(vouched, Instant::now());
+    }
+
+    /// [`Self::note`] at a given time: writes when the chain changed and the
+    /// last write attempt is at least [`MARKER_MIN_INTERVAL`] old.
+    pub fn note_at(&self, vouched: VouchedChain, now: Instant) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.written == Some(vouched) {
+            return;
+        }
+        if state
+            .attempted_at
+            .is_some_and(|at| now.saturating_duration_since(at) < MARKER_MIN_INTERVAL)
+        {
+            return;
+        }
+        state.attempted_at = Some(now);
+        match self.paths.write(&marker_contents(&self.build, vouched)) {
+            Ok(()) => state.written = Some(vouched),
+            Err(error) => {
+                if !state.warned {
+                    state.warned = true;
+                    warn!(target: LOG_TARGET, marker = ?self.paths.marker, %error, "could not write the replay marker: the next start replays in full (logged once)");
+                }
+            }
+        }
+    }
+}
+
+/// Records the chain `cryptarchia` holds in the marker. Used after the startup
+/// replay and whenever the node records its recovery state.
+pub fn note_chain(writer: &MarkerWriter, cryptarchia: &Cryptarchia) {
+    writer.note(VouchedChain {
+        tip: cryptarchia.tip(),
+        lib: cryptarchia.lib(),
+    });
+}
+
+static MARKER_WRITER: OnceLock<MarkerWriter> = OnceLock::new();
+
+/// After the startup replay: installs the process-wide marker writer and
+/// records the recovered chain.
+pub fn start_marker(paths: ReplayMarkerPaths, build: String, cryptarchia: &Cryptarchia) {
+    if MARKER_WRITER
+        .set(MarkerWriter::new(paths, build))
+        .is_err()
+    {
+        warn!(target: LOG_TARGET, "replay marker writer already installed");
+    }
+    if let Some(writer) = MARKER_WRITER.get() {
+        note_chain(writer, cryptarchia);
+    }
+}
+
+/// Records the in-memory chain in the marker, if the writer is installed.
+pub fn note_installed(cryptarchia: &Cryptarchia) {
+    if let Some(writer) = MARKER_WRITER.get() {
+        note_chain(writer, cryptarchia);
+    }
+}
+
+/// A leader proof seen through the replay: either verified as usual (and
+/// timed), or taken as already verified. All other values are passed through
+/// unchanged, so the ledger update is the same either way.
+///
+/// This implements every method of [`LeaderProof`] by hand. When moving to a
+/// new upstream version, check that the trait gained no method with a default
+/// body that `Groth16LeaderProof` overrides: this wrapper would silently use
+/// the default instead.
+pub struct ReplayLeaderProof<'a, P> {
+    inner: &'a P,
+    verify: bool,
+    spent: Cell<Duration>,
+}
+
+impl<'a, P: LeaderProof> ReplayLeaderProof<'a, P> {
+    pub const fn new(inner: &'a P, verify: bool) -> Self {
+        Self {
+            inner,
+            verify,
+            spent: Cell::new(Duration::ZERO),
+        }
+    }
+
+    /// Time spent verifying the proof so far.
+    pub fn spent(&self) -> Duration {
+        self.spent.get()
+    }
+}
+
+impl<P: LeaderProof> LeaderProof for ReplayLeaderProof<'_, P> {
+    fn verify(&self, public_inputs: &LeaderPublic) -> bool {
+        if !self.verify {
+            return true;
+        }
+        let started = Instant::now();
+        let valid = self.inner.verify(public_inputs);
+        self.spent
+            .set(self.spent.get().saturating_add(started.elapsed()));
+        valid
+    }
+
+    fn verify_genesis(&self) -> bool {
+        self.inner.verify_genesis()
+    }
+
+    fn entropy(&self) -> Fr {
+        self.inner.entropy()
+    }
+
+    fn leader_key(&self) -> &UnverifiedEd25519PublicKey {
+        self.inner.leader_key()
+    }
+
+    fn voucher_cm(&self) -> &VoucherCm {
+        self.inner.voucher_cm()
+    }
+}
+
+/// Where replay time goes. Process-wide counters, reset at the start of each
+/// chain recovery and reported in one log line at its end.
+pub mod timing {
+    use super::{AtomicU64, Duration, Ordering};
+
+    pub static READ: AtomicU64 = AtomicU64::new(0);
+    pub static DECODE: AtomicU64 = AtomicU64::new(0);
+    pub static LEDGER: AtomicU64 = AtomicU64::new(0);
+    pub static LEADER_PROOF: AtomicU64 = AtomicU64::new(0);
+    pub static BATCH_PROOFS: AtomicU64 = AtomicU64::new(0);
+    pub static STORE: AtomicU64 = AtomicU64::new(0);
+
+    pub fn reset() {
+        for counter in [&READ, &DECODE, &LEDGER, &LEADER_PROOF, &BATCH_PROOFS, &STORE] {
+            counter.store(0, Ordering::Relaxed);
+        }
+    }
+
+    pub fn add(counter: &AtomicU64, spent: Duration) {
+        let nanos = u64::try_from(spent.as_nanos()).unwrap_or(u64::MAX);
+        counter.fetch_add(nanos, Ordering::Relaxed);
+    }
+
+    pub fn secs(counter: &AtomicU64) -> f64 {
+        Duration::from_nanos(counter.load(Ordering::Relaxed)).as_secs_f64()
+    }
+}
