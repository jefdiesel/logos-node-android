+        let parents = [id(1), id(2), id(3), id(4)];
+        // Anchor at the stored tip: all fast.
+        assert_eq!(fast_prefix(&ids, &parents, lib, Some(3)), [true; 4]);
+        // Blocks after the anchor replay in full.
+        assert_eq!(fast_prefix(&ids, &parents, lib, Some(1)), [true, true, false, false]);
