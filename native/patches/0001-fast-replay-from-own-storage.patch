+/// Recovery state for a replay from the genesis block as LIB up to `tip`.
+fn recovery_from_genesis(stored: &Cryptarchia, tip: HeaderId) -> CryptarchiaConsensusState {
+    let genesis_id: HeaderId = GENESIS_ID.into();
+    CryptarchiaConsensusState {
+        tip,
+        lib: genesis_id,
+        lib_ledger_state: stored.ledger.state(&genesis_id).unwrap().clone(),
+        lib_block_length: 0,
+        lib_block_slot: Slot::genesis(),
+        lib_block_uncle_slots: UncleSlots::default(),
+        genesis_id,
+        storage_blocks_to_remove: HashSet::new(),
+        last_engine_state: None,
+    }
+}
+
+fn replay_bootstrap_config() -> BootstrapConfig {
+    BootstrapConfig {
+        prolonged_bootstrap_period: std::time::Duration::ZERO,
+        force_bootstrap: true,
+        offline_grace_period: OfflineGracePeriodConfig::default(),
+    }
+}
+
+/// The same block with its leader proof moved to the next slot, so the proof
+/// no longer verifies.
+fn with_bad_leader_proof(
+    valid: &Block<SignedOps<Preverified, StandardMode>>,
+    signing_key: &Ed25519Key,
+) -> Block<SignedOps<Preverified, StandardMode>> {
+    Block::create(
+        valid.header().parent(),
+        valid.header().slot().strict_add(1.into()),
+        UncleHeaders::empty(),
+        valid.header().leader_proof().clone(),
+        BlockTransactions::empty(),
+        signing_key,
+    )
+    .unwrap()
+}
+
+/// Patch 0001: a start that uses a marker verifies in full every block after
+/// the vouched tip. Stored chain `G -- B1 -- B2 -- B3`, where B3 carries a bad
+/// leader proof (first case) or a bad deferred proof (second case) and was
+/// written to storage directly (as a corrupt or foreign database would hold
+/// it). A marker vouching for B2 must not let B3 through.
+#[tokio::test(flavor = "multi_thread")]
+async fn replay_verifies_every_block_after_the_vouched_tip() {
+    type Tx = SignedOps<Preverified, StandardMode>;
+
+    for bad_leader_proof in [true, false] {
+        let (broadcast_tx, _broadcast_rx) = mpsc::channel(10);
+        let (storage_tx, storage_rx) = mpsc::channel(10);
+        let _storage_svc = spawn_storage_service(storage_rx);
+        let (time_tx, _time_rx) = mpsc::channel(10);
+        let relays = CryptarchiaConsensusRelays::<Tx>::new(
+            OutboundRelay::new(broadcast_tx),
+            StorageApi::new(OutboundRelay::new(storage_tx)),
+            OutboundRelay::new(time_tx),
+        );
+        let (new_block_tx, _new_block_rx) = broadcast::channel(100);
+        let (lib_tx, _lib_rx) = broadcast::channel(100);
+
+        let config = ledger_config(3.try_into().unwrap());
+        let genesis_id: HeaderId = GENESIS_ID.into();
+        let (zk_key, leader_utxo) = utxo();
+        let (_, funding) = utxo();
+        let mut stored = Cryptarchia::from_genesis(
+            genesis_id,
+            LedgerState::from_utxos([leader_utxo, funding], &config),
+            config,
+            lb_cryptarchia_engine::State::Bootstrapping,
+        );
+
+        let mut slot = Slot::genesis().strict_add(1.into());
+        let mut ids = Vec::new();
+        for _ in 0..2 {
+            let (block, _) = try_build_block(
+                &stored,
+                stored.tip(),
+                leader_utxo,
+                &zk_key,
+                slot,
+                UncleHeaders::empty(),
+            )
+            .unwrap();
+            slot = block.header().slot().strict_add(1.into());
+            ids.push(block.header().id());
+            process_block(
+                &mut stored,
+                block.clone(),
+                block.header().slot(),
+                BlockOrigin::Network,
+                &relays,
+                &new_block_tx,
+                &lib_tx,
+            )
+            .await
+            .unwrap();
+        }
+
+        let b3 = if bad_leader_proof {
+            let (valid, signing_key) = try_build_block(
+                &stored,
+                stored.tip(),
+                leader_utxo,
+                &zk_key,
+                slot,
+                UncleHeaders::empty(),
+            )
+            .unwrap();
+            with_bad_leader_proof(&valid, &signing_key)
+        } else {
+            // Spends `funding` with a signature from the wrong key; only the
+            // deferred proof check catches it.
+            let fake_key = ZkKey::from(Fr::from(42u64));
+            let bad_tx = transfer_tx(funding, Note::new(1, fake_key.to_public_key()), &fake_key)
+                .preverify()
+                .unwrap();
+            try_build_block_with_transactions(
+                &stored,
+                stored.tip(),
+                leader_utxo,
+                &zk_key,
+                slot,
+                UncleHeaders::empty(),
+                BlockTransactions::from([bad_tx]),
+            )
+            .unwrap()
+            .0
+        };
+        let b3_id = b3.header().id();
+        relays
+            .storage()
+            .store_block_data(
+                b3_id,
+                b3.header().parent(),
+                b3.clone(),
+                lb_core::events::Events::new(),
+                std::collections::BTreeMap::new(),
+            )
+            .await
+            .unwrap();
+
+        let recovery_state = recovery_from_genesis(&stored, b3_id);
+        let replay = async |vouched_tip: Option<HeaderId>| {
+            CryptarchiaConsensus::<Tx, SystemTimeBackend, TestRuntimeServiceId>::initialize_cryptarchia_with(
+                &recovery_state,
+                &replay_bootstrap_config(),
+                stored.ledger.config().clone(),
+                &relays,
+                &new_block_tx,
+                &lib_tx,
+                b3.header().slot(),
+                vouched_tip.map(|tip| VouchedChain { tip, lib: genesis_id }),
+            )
+            .await
+        };
+
+        let kind = if bad_leader_proof { "leader proof" } else { "deferred proof" };
+        assert!(replay(None).await.is_err(), "full replay must reject the bad {kind}");
+        assert!(
+            replay(Some(ids[1])).await.is_err(),
+            "a marker vouching for B2 must not skip the bad {kind} in B3"
+        );
+        // Only a marker that vouches for B3 itself skips it: what fast mode trusts.
+        let trusted = replay(Some(b3_id)).await.expect("B3 vouched for");
+        assert_eq!(trusted.replayed_fast, 3);
+    }
+}
+
+/// Patch 0001: a marker whose tip is on another branch vouches only for the
+/// blocks that branch shares with the stored chain, found through the
+/// headers' parents. Stored chain `G -- B1 -- B2` (B2 with a bad leader proof),
+/// a fork `B1 -- U2`, and a block `U1` on `G`.
+#[tokio::test(flavor = "multi_thread")]
+async fn marker_on_another_branch_vouches_only_the_shared_blocks() {
+    type Tx = SignedOps<Preverified, StandardMode>;
+
+    let (broadcast_tx, _broadcast_rx) = mpsc::channel(10);
+    let (storage_tx, storage_rx) = mpsc::channel(10);
+    let _storage_svc = spawn_storage_service(storage_rx);
+    let (time_tx, _time_rx) = mpsc::channel(10);
+    let relays = CryptarchiaConsensusRelays::<Tx>::new(
+        OutboundRelay::new(broadcast_tx),
+        StorageApi::new(OutboundRelay::new(storage_tx)),
+        OutboundRelay::new(time_tx),
+    );
+    let (new_block_tx, _new_block_rx) = broadcast::channel(100);
+    let (lib_tx, _lib_rx) = broadcast::channel(100);
+
+    let genesis_id: HeaderId = GENESIS_ID.into();
+    let (zk_key, utxo) = utxo();
+    let mut stored = genesis_cryptarchia(utxo);
+    let slot = Slot::genesis().strict_add(1.into());
+
+    // U1 extends G; it is only written to storage.
+    let (u1, _) =
+        try_build_block(&stored, genesis_id, utxo, &zk_key, slot, UncleHeaders::empty()).unwrap();
+    relays
+        .storage()
+        .store_block_data(
+            u1.header().id(),
+            genesis_id,
+            u1.clone(),
+            lb_core::events::Events::new(),
+            std::collections::BTreeMap::new(),
+        )
+        .await
+        .unwrap();
+
+    let apply = async |stored: &mut Cryptarchia, block: Block<Tx>| {
+        process_block(
+            stored,
+            block.clone(),
+            block.header().slot(),
+            BlockOrigin::Network,
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+        )
+        .await
+        .unwrap();
+    };
+    let (b1, _) =
+        try_build_block(&stored, genesis_id, utxo, &zk_key, slot, UncleHeaders::empty()).unwrap();
+    let b1_id = b1.header().id();
+    apply(&mut stored, b1.clone()).await;
+    let next = b1.header().slot().strict_add(1.into());
+    let (u2, _) =
+        try_build_block(&stored, b1_id, utxo, &zk_key, next, UncleHeaders::empty()).unwrap();
+    let (b2_valid, b2_key) =
+        try_build_block(&stored, b1_id, utxo, &zk_key, next, UncleHeaders::empty()).unwrap();
+    let b2 = with_bad_leader_proof(&b2_valid, &b2_key);
+    apply(&mut stored, u2.clone()).await;
+    relays
+        .storage()
+        .store_block_data(
+            b2.header().id(),
+            b1_id,
+            b2.clone(),
+            lb_core::events::Events::new(),
+            std::collections::BTreeMap::new(),
+        )
+        .await
+        .unwrap();
+    let path = [b1_id, b2.header().id()];
+
+    type Service = CryptarchiaConsensus<Tx, SystemTimeBackend, TestRuntimeServiceId>;
+    // The fork tip leads back to B1 through U2's header: only B1 is shared.
+    assert_eq!(
+        Service::vouched_anchor(u2.header().id(), genesis_id, &path, relays.storage()).await,
+        Some(0)
+    );
+    // A branch off the LIB, or an unknown tip: nothing is shared.
+    assert_eq!(
+        Service::vouched_anchor(u1.header().id(), genesis_id, &path, relays.storage()).await,
+        None
+    );
+    assert_eq!(
+        Service::vouched_anchor([9; 32].into(), genesis_id, &path, relays.storage()).await,
+        None
+    );
+
+    let recovery_state = recovery_from_genesis(&stored, b2.header().id());
+    let replay = async |vouched_tip: HeaderId| {
+        Service::initialize_cryptarchia_with(
+            &recovery_state,
+            &replay_bootstrap_config(),
+            stored.ledger.config().clone(),
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+            b2.header().slot(),
+            Some(VouchedChain { tip: vouched_tip, lib: genesis_id }),
+        )
+        .await
+    };
+    for tip in [u2.header().id(), u1.header().id(), [9; 32].into()] {
+        assert!(replay(tip).await.is_err(), "the bad B2 must be verified and rejected");
+    }
+}
