+/// Patch 0001: a block with a bad leader proof, or with a bad deferred
+/// transaction proof, is still rejected when it comes from the network and
+/// when stored blocks are replayed with full verification. Only a trusted
+/// replay of the node's own storage skips these two checks, which is what
+/// that mode trusts the database for.
+#[test]
+fn proofs_are_skipped_only_in_trusted_replay() {
+    // A block whose leader proof was made for another slot.
+    let config = ledger_config(3.try_into().unwrap());
+    let (zk_key, utxo_1) = utxo();
+    let cryptarchia = Cryptarchia::from_genesis(
+        GENESIS_ID.into(),
+        LedgerState::from_utxos([utxo_1], &config),
+        config,
+        lb_cryptarchia_engine::State::Online,
+    );
+    let (valid, signing_key) = try_build_block(
+        &cryptarchia,
+        cryptarchia.tip(),
+        utxo_1,
+        &zk_key,
+        Slot::new(1),
+        UncleHeaders::empty(),
+    )
+    .unwrap();
+    let wrong_slot = valid.header().slot().strict_add(1.into());
+    let bad_leader_proof: Block<SignedOps<Preverified, StandardMode>> = Block::create(
+        cryptarchia.tip(),
+        wrong_slot,
+        UncleHeaders::empty(),
+        valid.header().leader_proof().clone(),
+        BlockTransactions::empty(),
+        &signing_key,
+    )
+    .unwrap();
+
+    for origin in [BlockOrigin::Network, BlockOrigin::Storage] {
+        let error = cryptarchia
+            .clone()
+            .try_apply_block_with_state_retention(bad_leader_proof.clone(), wrong_slot, origin)
+            .err();
+        assert!(
+            matches!(error, Some(Error::Ledger(lb_ledger::LedgerError::InvalidProof))),
+            "{origin:?} must reject a bad leader proof, got {error:?}"
+        );
+    }
+    let mut trusted = cryptarchia.clone();
+    trusted
+        .try_apply_block_with_state_retention(
+            bad_leader_proof.clone(),
+            wrong_slot,
+            BlockOrigin::TrustedStorage,
+        )
+        .expect("a trusted replay does not re-verify the leader proof");
+    assert_eq!(trusted.tip(), bad_leader_proof.header().id());
+
+    // A block carrying a transaction with a bad deferred proof.
+    let config = ledger_config(NonZero::<u32>::new(1).unwrap());
+    let (zk_key, utxo_2) = utxo();
+    let cryptarchia = Cryptarchia::from_genesis(
+        GENESIS_ID.into(),
+        LedgerState::from_utxos([utxo_2], &config),
+        config,
+        lb_cryptarchia_engine::State::Bootstrapping,
+    );
+    let fake_key = ZkKey::from(Fr::from(42u64));
+    let (bad_deferred_proof, _) = try_build_block_with_transactions(
+        &cryptarchia,
+        cryptarchia.tip(),
+        utxo_2,
+        &zk_key,
+        Slot::new(1),
+        UncleHeaders::empty(),
+        BlockTransactions::from([transfer_tx_with_fake_sig(utxo_2, &fake_key)]),
+    )
+    .expect("should find a winning slot");
+    let slot = bad_deferred_proof.header().slot();
+
+    for origin in [BlockOrigin::Network, BlockOrigin::Storage] {
+        let error = cryptarchia
+            .clone()
+            .try_apply_block_with_state_retention(bad_deferred_proof.clone(), slot, origin)
+            .err();
+        assert!(
+            matches!(error, Some(Error::BatchDeferredProofVerification(_))),
+            "{origin:?} must reject a bad deferred proof, got {error:?}"
+        );
+    }
+    let mut trusted = cryptarchia;
+    trusted
+        .try_apply_block_with_state_retention(
+            bad_deferred_proof.clone(),
+            slot,
+            BlockOrigin::TrustedStorage,
+        )
+        .expect("a trusted replay does not re-verify deferred proofs");
+    assert_eq!(trusted.tip(), bad_deferred_proof.header().id());
+}
+
+/// Patch 0001: after a recovery that fell back to LIB (the tip branch could
+/// not be loaded), the marker written for the recovered chain vouches for no
+/// stored block, so the next start replays all of them in full; and the
+/// marker read back drives the next start's choice (the wiring in `run`).
+#[tokio::test(flavor = "multi_thread")]
+async fn marker_after_fall_back_to_lib_vouches_for_nothing() {
+    type Tx = SignedOps<Preverified, StandardMode>;
+
+    let (broadcast_tx, _broadcast_rx) = mpsc::channel(10);
+    let (storage_tx, storage_rx) = mpsc::channel(10);
+    let _storage_svc = spawn_storage_service(storage_rx);
+    let (time_tx, _time_rx) = mpsc::channel(10);
+    let relays = CryptarchiaConsensusRelays::<Tx>::new(
+        OutboundRelay::new(broadcast_tx),
+        StorageApi::new(OutboundRelay::new(storage_tx)),
+        OutboundRelay::new(time_tx),
+    );
+    let (new_block_tx, _new_block_rx) = broadcast::channel(10);
+    let (lib_tx, _lib_rx) = broadcast::channel(10);
+
+    // A stored chain G -- B1 -- B2, written by "another binary".
+    let (zk_key, utxo) = utxo();
+    let mut stored = genesis_cryptarchia(utxo);
+    let mut blocks = Vec::new();
+    let mut slot = Slot::genesis().strict_add(1.into());
+    for _ in 0..2 {
+        let (block, _) =
+            try_build_block(&stored, stored.tip(), utxo, &zk_key, slot, UncleHeaders::empty())
+                .unwrap();
+        slot = block.header().slot().strict_add(1.into());
+        process_block(
+            &mut stored,
+            block.clone(),
+            block.header().slot(),
+            BlockOrigin::Network,
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+        )
+        .await
+        .unwrap();
+        blocks.push(block);
+    }
+    let genesis_id: HeaderId = GENESIS_ID.into();
+    let stored_ids = blocks.iter().map(|b| b.header().id()).collect::<Vec<_>>();
+
+    // The recovery state names a tip that is missing from storage.
+    let recovery_state = CryptarchiaConsensusState {
+        tip: [7; 32].into(),
+        lib: genesis_id,
+        lib_ledger_state: stored.ledger.state(&genesis_id).unwrap().clone(),
+        lib_block_length: 0,
+        lib_block_slot: Slot::genesis(),
+        lib_block_uncle_slots: UncleSlots::default(),
+        genesis_id,
+        storage_blocks_to_remove: HashSet::new(),
+        last_engine_state: None,
+    };
+    let bootstrap_config = BootstrapConfig {
+        prolonged_bootstrap_period: std::time::Duration::ZERO,
+        force_bootstrap: true,
+        offline_grace_period: OfflineGracePeriodConfig::default(),
+    };
+    let initialized = CryptarchiaConsensus::<Tx, SystemTimeBackend, TestRuntimeServiceId>::initialize_cryptarchia_with(
+        &recovery_state,
+        &bootstrap_config,
+        stored.ledger.config().clone(),
+        &relays,
+        &new_block_tx,
+        &lib_tx,
+        slot,
+        None,
+    )
+    .await
+    .unwrap();
+    assert!(initialized.fell_back_to_lib);
+
+    // What `run` does after the recovery: the marker follows the recovered chain.
+    let dir = TempDir::new().unwrap();
+    let paths = ReplayMarkerPaths::next_to_db(&dir.path().join("db"));
+    let build = "test build".to_owned();
+    MarkerWriter::new(paths.clone(), build.clone())
+        .note(VouchedChain { tip: initialized.cryptarchia.tip(), lib: initialized.cryptarchia.lib() });
+
+    // Next start, with the tip branch loadable again: the marker matches the
+    // stored LIB but vouches for none of the stored blocks.
+    let (vouched, _) = choose_replay(None, Some(&build), paths.read().as_deref(), genesis_id);
+    assert_eq!(vouched, Some(VouchedChain { tip: genesis_id, lib: genesis_id }));
+    assert_eq!(fast_flags(&stored_ids, vouched), [false, false]);
+
+    // Whereas a marker written for the full chain vouches for all of it.
+    MarkerWriter::new(paths.clone(), build.clone())
+        .note(VouchedChain { tip: stored.tip(), lib: genesis_id });
+    let (vouched, _) = choose_replay(None, Some(&build), paths.read().as_deref(), genesis_id);
+    assert_eq!(fast_flags(&stored_ids, vouched), [true, true]);
 }
