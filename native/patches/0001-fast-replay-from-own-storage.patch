+#[cfg(test)]
+mod tests {
+    use super::{ReplayMarkerPaths, ReplayVerification, build_id, choose_replay, marker_contents};
+
+    #[test]
+    fn replay_marker_missing_different_or_same() {
+        let expected = marker_contents(&build_id(), Some("db-1\n"));
+        let other_build = marker_contents("0.3.3 none -", Some("db-1"));
+        let other_db = marker_contents(&build_id(), Some("db-2"));
+
+        // Missing marker: full.
+        let (mode, _) = choose_replay(None, None, Some(&expected));
+        assert_eq!(mode, ReplayVerification::Full);
+        // Marker from another build (e.g. an upgrade) or another database: full.
+        let (mode, _) = choose_replay(None, Some(&other_build), Some(&expected));
+        assert_eq!(mode, ReplayVerification::Full);
+        let (mode, _) = choose_replay(None, Some(&other_db), Some(&expected));
+        assert_eq!(mode, ReplayVerification::Full);
+        // Same build and database: fast.
+        let (mode, _) = choose_replay(None, Some(&expected), Some(&expected));
+        assert_eq!(mode, ReplayVerification::Fast);
+        let (mode, _) = choose_replay(Some("fast"), Some(&expected), Some(&expected));
+        assert_eq!(mode, ReplayVerification::Fast);
+        // The switch forces full even with a matching marker, and nothing
+        // forces fast.
+        let (mode, _) = choose_replay(Some("full"), Some(&expected), Some(&expected));
+        assert_eq!(mode, ReplayVerification::Full);
+        let (mode, _) = choose_replay(Some("fast"), None, Some(&expected));
+        assert_eq!(mode, ReplayVerification::Full);
+        // No marker location: full.
+        let (mode, _) = choose_replay(None, Some(&expected), None);
+        assert_eq!(mode, ReplayVerification::Full);
+    }
+
+    #[test]
+    fn replay_marker_file_round_trip() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let db = dir.path().join("db");
+        std::fs::create_dir(&db).unwrap();
+        std::fs::write(db.join("IDENTITY"), "1234-abcd\n").unwrap();
+        let paths = ReplayMarkerPaths::next_to_db(&db);
+        assert_eq!(paths.marker, dir.path().join("db.replay-verified"));
+
+        // Missing, then written after a full replay, then matching.
+        assert_eq!(paths.read(), None);
+        let expected = paths.expected();
+        assert!(expected.contains("db 1234-abcd\n"));
+        paths.write(&expected).unwrap();
+        assert_eq!(paths.read().as_deref(), Some(expected.as_str()));
+        let (mode, _) = choose_replay(None, paths.read().as_deref(), Some(&paths.expected()));
+        assert_eq!(mode, ReplayVerification::Fast);
+
+        // The database is replaced by a copy from elsewhere: full again.
+        std::fs::write(db.join("IDENTITY"), "5678-ef01\n").unwrap();
+        let (mode, _) = choose_replay(None, paths.read().as_deref(), Some(&paths.expected()));
+        assert_eq!(mode, ReplayVerification::Full);
+    }
+
+    #[test]
+    fn replay_verification_defaults_to_fast_and_fails_safe() {
+        assert_eq!(ReplayVerification::parse(None), ReplayVerification::Fast);
+        assert_eq!(ReplayVerification::parse(Some("")), ReplayVerification::Fast);
+        assert_eq!(ReplayVerification::parse(Some("fast")), ReplayVerification::Fast);
+        assert_eq!(ReplayVerification::parse(Some(" FAST ")), ReplayVerification::Fast);
+        assert_eq!(ReplayVerification::parse(Some("full")), ReplayVerification::Full);
+        assert_eq!(ReplayVerification::parse(Some("Full")), ReplayVerification::Full);
+        // Anything unrecognised keeps full verification on.
+        assert_eq!(ReplayVerification::parse(Some("0")), ReplayVerification::Full);
+        assert_eq!(ReplayVerification::parse(Some("off")), ReplayVerification::Full);
+    }
+}
