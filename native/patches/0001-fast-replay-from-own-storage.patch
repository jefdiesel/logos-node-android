+/// A leader proof seen through the replay: either verified as usual (and
+/// timed), or taken as already verified. All other values are passed through
+/// unchanged, so the ledger update is the same either way.
+pub struct ReplayLeaderProof<'a, P> {
+    inner: &'a P,
+    verify: bool,
+    spent: Cell<Duration>,
+}
+
+impl<'a, P: LeaderProof> ReplayLeaderProof<'a, P> {
+    pub const fn new(inner: &'a P, verify: bool) -> Self {
+        Self {
+            inner,
+            verify,
+            spent: Cell::new(Duration::ZERO),
+        }
+    }
+
+    /// Time spent verifying the proof so far.
+    pub fn spent(&self) -> Duration {
+        self.spent.get()
+    }
+}
+
+impl<P: LeaderProof> LeaderProof for ReplayLeaderProof<'_, P> {
+    fn verify(&self, public_inputs: &LeaderPublic) -> bool {
+        if !self.verify {
+            return true;
+        }
+        let started = Instant::now();
+        let valid = self.inner.verify(public_inputs);
+        self.spent
+            .set(self.spent.get().saturating_add(started.elapsed()));
+        valid
+    }
+
+    fn verify_genesis(&self) -> bool {
+        self.inner.verify_genesis()
+    }
+
+    fn entropy(&self) -> Fr {
+        self.inner.entropy()
+    }
+
+    fn leader_key(&self) -> &UnverifiedEd25519PublicKey {
+        self.inner.leader_key()
+    }
+
+    fn voucher_cm(&self) -> &VoucherCm {
+        self.inner.voucher_cm()
+    }
+}
