+/// Patch 0001: after a recovery that fell back to LIB (the tip branch could
+/// not be loaded), the marker written for the recovered chain vouches for no
+/// stored block, so the next start replays all of them in full. Uses the same
+/// steps as the node: `plan_replay` (marker read and choice) before the
+/// recovery, `note_chain` (as `run` and `record_recovery_state` do) after it.
+#[tokio::test(flavor = "multi_thread")]
+async fn marker_after_fall_back_to_lib_vouches_for_nothing() {
+    type Tx = SignedOps<Preverified, StandardMode>;
+    type Service = CryptarchiaConsensus<Tx, SystemTimeBackend, TestRuntimeServiceId>;
+
+    let (broadcast_tx, _broadcast_rx) = mpsc::channel(10);
+    let (storage_tx, storage_rx) = mpsc::channel(10);
+    let _storage_svc = spawn_storage_service(storage_rx);
+    let (time_tx, _time_rx) = mpsc::channel(10);
+    let relays = CryptarchiaConsensusRelays::<Tx>::new(
+        OutboundRelay::new(broadcast_tx),
+        StorageApi::new(OutboundRelay::new(storage_tx)),
+        OutboundRelay::new(time_tx),
+    );
+    let (new_block_tx, _new_block_rx) = broadcast::channel(10);
+    let (lib_tx, _lib_rx) = broadcast::channel(10);
+
+    // A stored chain G -- B1 -- B2.
+    let (zk_key, utxo) = utxo();
+    let mut stored = genesis_cryptarchia(utxo);
+    let mut slot = Slot::genesis().strict_add(1.into());
+    for _ in 0..2 {
+        let (block, _) =
+            try_build_block(&stored, stored.tip(), utxo, &zk_key, slot, UncleHeaders::empty())
+                .unwrap();
+        slot = block.header().slot().strict_add(1.into());
+        process_block(
+            &mut stored,
+            block.clone(),
+            block.header().slot(),
+            BlockOrigin::Network,
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+        )
+        .await
+        .unwrap();
+    }
+    let genesis_id: HeaderId = GENESIS_ID.into();
+    let tip = stored.tip();
+
+    let dir = TempDir::new().unwrap();
+    let paths = ReplayMarkerPaths::next_to_db(&dir.path().join("db"));
+    // The real build id when the tests are built with one (CI), else a stand-in.
+    let build = build_id().unwrap_or_else(|| "test build".to_owned());
+    let recover = async |state: &CryptarchiaConsensusState| {
+        let (vouched, _) = plan_replay(Some(&paths), None, Some(&build), state.lib);
+        Service::initialize_cryptarchia_with(
+            state,
+            &replay_bootstrap_config(),
+            stored.ledger.config().clone(),
+            &relays,
+            &new_block_tx,
+            &lib_tx,
+            slot,
+            vouched,
+        )
+        .await
+        .unwrap()
+    };
+
+    // First start: the recovery state names a tip missing from storage.
+    let fell_back = recover(&recovery_from_genesis(&stored, [7; 32].into())).await;
+    assert!(fell_back.fell_back_to_lib);
+    note_chain(&MarkerWriter::new(paths.clone(), build.clone()), &fell_back.cryptarchia);
+
+    // Next start, with the tip branch loadable: nothing is vouched for.
+    let full = recover(&recovery_from_genesis(&stored, tip)).await;
+    assert_eq!(full.cryptarchia.tip(), tip);
+    assert_eq!(full.replayed_fast, 0);
+    note_chain(&MarkerWriter::new(paths.clone(), build.clone()), &full.cryptarchia);
+
+    // The start after that: the marker now vouches for both blocks.
+    let fast = recover(&recovery_from_genesis(&stored, tip)).await;
+    assert_eq!(fast.replayed_fast, 2);
+    assert_eq!(fast.cryptarchia.ledger, full.cryptarchia.ledger);
 }
