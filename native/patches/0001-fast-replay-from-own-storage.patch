@@ -0,0 +1,337 @@
+//! Fast replay of the node's own stored blocks at startup.
+//!
+//! Added by the logos-node-android patch `0001-fast-replay-from-own-storage`.
+//!
+//! At startup the chain is rebuilt from the last immutable block (LIB) by
+//! replaying every stored block after it. Those blocks were fully verified by
+//! this node before it stored them, so a fast replay skips the two
+//! expensive cryptographic re-checks: the leader proof (`PoL` Groth16) and the
+//! batch of deferred transaction proofs. Everything else runs as before: the
+//! block is decoded (header signature, body root, transaction pre-checks), its
+//! id is checked against the id it is stored under, it is linked to its parent,
+//! the ledger transition and the consensus engine run in full.
+//!
+//! A fast replay is only used when a marker next to the database says that
+//! this same build already replayed this same database with full verification
+//! (see [`ReplayMarkerPaths`]). A new node version, a changed patch set, a
+//! replaced database or a missing marker all lead to one full replay, after
+//! which the marker is written and later starts are fast again.
+//!
+//! Set `LOGOS_REPLAY_VERIFY=full` to re-verify everything on a start anyway.
+
+use std::{
+    cell::Cell,
+    ffi::OsString,
+    fs, io,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicU64, Ordering},
+    time::{Duration, Instant},
+};
+
+use lb_core::{
+    mantle::ops::leader_claim::VoucherCm,
+    proofs::leader_proof::{LeaderProof, LeaderPublic},
+};
+use lb_groth16::Fr;
+use lb_key_management_system_keys::keys::UnverifiedEd25519PublicKey;
+
+/// The patches compiled into this node, for the startup log line.
+pub const NODE_PATCHES: &str = "0001-fast-replay-from-own-storage";
+
+/// Environment variable that selects how stored blocks are replayed.
+pub const REPLAY_VERIFY_ENV: &str = "LOGOS_REPLAY_VERIFY";
+
+/// How blocks loaded from the node's own storage are verified at startup.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ReplayVerification {
+    /// Skip the leader proof and the deferred transaction proofs, which this
+    /// node verified before storing the block. Used when the replay marker
+    /// matches (see [`choose_replay`]).
+    Fast,
+    /// Verify everything again, exactly as the unpatched node does.
+    Full,
+}
+
+impl ReplayVerification {
+    /// Parses [`REPLAY_VERIFY_ENV`]. Unset, empty or `fast` gives
+    /// [`Self::Fast`]; `full` gives [`Self::Full`]. Any other value also gives
+    /// [`Self::Full`], so a typo never turns verification off.
+    #[must_use]
+    pub fn from_env() -> Self {
+        Self::parse(std::env::var(REPLAY_VERIFY_ENV).ok().as_deref())
+    }
+
+    #[must_use]
+    pub fn parse(value: Option<&str>) -> Self {
+        match value.map(str::trim) {
+            None | Some("") => Self::Fast,
+            Some(v) if v.eq_ignore_ascii_case("fast") => Self::Fast,
+            Some(_) => Self::Full,
+        }
+    }
+
+    #[must_use]
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Fast => "fast",
+            Self::Full => "full",
+        }
+    }
+}
+
+/// Identifies this build in the replay marker: the upstream version, the
+/// patches, and (when the build sets it) a digest of the patch files.
+#[must_use]
+pub fn build_id() -> String {
+    format!(
+        "{} {} {}",
+        env!("CARGO_PKG_VERSION"),
+        NODE_PATCHES,
+        option_env!("LOGOS_NODE_PATCHES_ID").unwrap_or("-"),
+    )
+}
+
+/// Where the replay marker lives, and the database it vouches for.
+///
+/// The marker is a small text file next to the database folder (never inside
+/// it, so a copy of the database folder does not carry it). It names the build
+/// that last replayed the stored blocks with full verification, and the
+/// database's `RocksDB` identity. A fast replay is only used when both match
+/// the running build and the database on disk; otherwise the start does a full
+/// replay and then writes a new marker.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ReplayMarkerPaths {
+    pub marker: PathBuf,
+    pub db: PathBuf,
+}
+
+impl ReplayMarkerPaths {
+    /// The marker for the database at `db`: `<db>.replay-verified`, in the
+    /// same folder as the database folder.
+    #[must_use]
+    pub fn next_to_db(db: &Path) -> Self {
+        let mut name = db
+            .file_name()
+            .map_or_else(|| OsString::from("db"), OsString::from);
+        name.push(".replay-verified");
+        Self {
+            marker: db.with_file_name(name),
+            db: db.to_path_buf(),
+        }
+    }
+
+    /// What the marker must say for a fast replay of this database by this
+    /// build.
+    #[must_use]
+    pub fn expected(&self) -> String {
+        let identity = fs::read_to_string(self.db.join("IDENTITY")).ok();
+        marker_contents(&build_id(), identity.as_deref())
+    }
+
+    /// The marker as it is on disk, if there is one.
+    #[must_use]
+    pub fn read(&self) -> Option<String> {
+        fs::read_to_string(&self.marker).ok()
+    }
+
+    /// Writes the marker (to a temporary file first, then renamed).
+    pub fn write(&self, contents: &str) -> io::Result<()> {
+        let mut tmp = self.marker.clone().into_os_string();
+        tmp.push(".tmp");
+        fs::write(&tmp, contents)?;
+        fs::rename(&tmp, &self.marker)
+    }
+}
+
+#[must_use]
+pub fn marker_contents(build: &str, db_identity: Option<&str>) -> String {
+    let identity = db_identity.map(str::trim).filter(|id| !id.is_empty());
+    format!("build {build}\ndb {}\n", identity.unwrap_or("none"))
+}
+
+/// Chooses the replay mode for this start.
+///
+/// `env` is the value of [`REPLAY_VERIFY_ENV`], `marker` the marker on disk
+/// and `expected` what it must say for this build and database (`None` when
+/// the node has no marker location). Fast only when nothing asks for full and
+/// the marker matches; the environment can force full but never fast.
+#[must_use]
+pub fn choose_replay(
+    env: Option<&str>,
+    marker: Option<&str>,
+    expected: Option<&str>,
+) -> (ReplayVerification, &'static str) {
+    if ReplayVerification::parse(env) == ReplayVerification::Full {
+        return (ReplayVerification::Full, "forced by LOGOS_REPLAY_VERIFY");
+    }
+    let Some(expected) = expected else {
+        return (ReplayVerification::Full, "no replay marker location");
+    };
+    match marker {
+        None => (
+            ReplayVerification::Full,
+            "no replay marker: stored blocks not yet verified by this build",
+        ),
+        Some(marker) if marker == expected => (
+            ReplayVerification::Fast,
+            "replay marker matches this build and database",
+        ),
+        Some(_) => (
+            ReplayVerification::Full,
+            "replay marker is from another build or another database",
+        ),
+    }
+}
