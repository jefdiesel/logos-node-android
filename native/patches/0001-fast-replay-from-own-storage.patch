+/// Logs where the replay time went, and the replayed state, so that a fast
+/// and a full replay of the same database can be compared from their logs.
+fn log_replay_summary(
+    cryptarchia: &Cryptarchia,
+    n_blocks: usize,
+    n_fast: usize,
+    load_secs: f64,
+    apply_secs: f64,
+) {
+    let ledger_secs = timing::secs(&timing::LEDGER);
+    let leader_secs = timing::secs(&timing::LEADER_PROOF);
+    let batch_secs = timing::secs(&timing::BATCH_PROOFS);
+    let store_secs = timing::secs(&timing::STORE);
+    info!(
+        target: LOG_TARGET,
+        "replay timing ({n_blocks} blocks: {n_fast} fast, {} with full verification): load {load_secs:.2}s [read {:.2}s, decode {:.2}s], apply {apply_secs:.2}s [ledger {ledger_secs:.2}s of which leader proofs {leader_secs:.2}s, batch proofs {batch_secs:.2}s, store {store_secs:.2}s, rest {:.2}s]",
+        n_blocks - n_fast,
+        timing::secs(&timing::READ),
+        timing::secs(&timing::DECODE),
+        apply_secs - ledger_secs - batch_secs - store_secs,
+    );
+    let tip = cryptarchia.tip_branch();
+    let lib = cryptarchia.lib_branch();
+    if let Some(state) = cryptarchia.ledger.state(&tip.id()) {
+        info!(
+            target: LOG_TARGET,
+            "replay result: tip {} height {} slot {:?}, lib {} height {}, ledger slot {:?} latest_utxo_root {:?} aged_utxo_root {:?} epoch_nonce {:?} next_epoch_nonce {:?}",
