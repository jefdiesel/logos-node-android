<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the node's own peer-to-peer traffic, the wallet server's requests (node API, name service),
         and the screens reading the node's API and the wallet page on 127.0.0.1 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- keeps the CPU awake while the node runs, so it keeps up with its peers with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the phone's fingerprint check, for unlocking the wallet (strong biometrics only) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".LogosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- the wallet: the web app's page, served by its server.py running in this app. It has a
             process of its own (with the Python), so nothing in the wallet can take the node down. -->
        <activity
            android:name=".WalletActivity"
            android:process=":wallet"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the Node screen: start, stop, process state, log -->
        <activity
            android:name=".NodeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- specialUse: a peer-to-peer node has to keep running with no time limit, which none of the
             other foreground service types allow (dataSync, for one, is capped at 6 hours a day).
             Exported only to holders of DUMP, which the adb shell has and ordinary apps cannot get, so
             the node can be started and stopped from adb ("am start-foreground-service", see README). -->
        <service
            android:name=".NodeService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a Logos blockchain node, a peer-to-peer process that must stay connected to its peers while the user wants it running" />
        </service>
    </application>
</manifest>
